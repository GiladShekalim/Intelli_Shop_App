# ── docs/ : final deliverables are tracked; local planning notes stay local ──
# Everything under docs/ is ignored by default (planning notes, analysis, the
# local test runner). Only the production deliverables below are re-included.
/docs/*
!/docs/screenshots/
!/docs/IntelliShop-Project-Proposal.pdf
!/docs/Smart-Consumerism-Poster.pdf
!/docs/Smart-Consumerism-Final-Project-Book.pdf
!/docs/FIGMA.md
*.plan.md
PLAN*.md
IMPLEMENTATION_PLAN.md
BACKEND_ANALYSIS.md

# ── Secrets (NEVER commit) ─────────────────────────────
.env
*.env
!*.env.example
backend/**/.env

# ── Python / Django backend ────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
*.sqlite3
db.sqlite3
*.log
staticfiles/

# ── Android / Gradle ───────────────────────────────────
*.iml
.gradle/
local.properties
/build/
**/build/
.cxx/
captures/
*.apk
*.aab
*.keystore
!debug.keystore

# ── IDE / OS ───────────────────────────────────────────
.idea/
.DS_Store
Thumbs.db
