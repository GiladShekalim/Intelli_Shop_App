# Copy this file to `.env` (same dir the backend loads it from) and fill in real values.
# `.env` is gitignored — NEVER commit real credentials. No secrets are hardcoded in the source.

# MongoDB Atlas connection (business data: users, coupons)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/IntelliDB?retryWrites=true&w=majority
MONGODB_NAME=IntelliDB

# Django
SECRET_KEY=your-secret-key-here
DEBUG=True

# Groq API (AI filter helper / offline enhancement)
GROQ_API_KEY=<your_api_key_here>

# Admin MFA gate (web/admin console only — out of scope for the Android app)
ADMIN_MFA_PASSWORD=<choose-a-strong-password>

# Google Sign-In: the OAuth 2.0 Web client ID from Google Cloud Console.
# Used to verify Google ID tokens sent by the app. Same value goes in the app.
GOOGLE_CLIENT_ID=<your-web-client-id>.apps.googleusercontent.com
