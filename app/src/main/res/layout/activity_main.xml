<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_LAY_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">

    <!-- Static top bar: AI Filter (purple) | search field (light green) | Search (green) -->
    <LinearLayout
        android:id="@+id/main_LAY_topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/main_BTN_ai"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:text="@string/search_ai"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:backgroundTint="@color/ai_purple"
            app:cornerRadius="12dp" />

        <EditText
            android:id="@+id/main_ET_search"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_search"
            android:paddingHorizontal="16dp"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:autofillHints="@null"
            android:importantForAutofill="no" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/main_BTN_search"
            style="@style/Widget.MaterialComponents.Button.Icon"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="0dp"
            android:contentDescription="@string/search_go"
            app:backgroundTint="@color/search_btn_bg"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_search"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="22dp"
            app:iconTint="@color/brand_primary" />
    </LinearLayout>

    <!-- Content: fragments show/hide here -->
    <FrameLayout
        android:id="@+id/main_FRAME_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/main_LAY_topBar"
        app:layout_constraintBottom_toTopOf="@id/main_DIV_bottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/main_DIV_bottom"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/main_LAY_bottomBar" />

    <!-- Custom bottom 3-tab bar -->
    <LinearLayout
        android:id="@+id/main_LAY_bottomBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/bottom_bar_bg"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/main_LAY_tabHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/main_IMG_tabHome"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/tab_home"
                android:src="@drawable/ic_tab_home"
                app:tint="@color/brand_primary" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/main_LBL_tabHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_home"
                android:textColor="@color/brand_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/main_LAY_tabCoupons"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/main_IMG_tabCoupons"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/tab_coupons"
                android:src="@drawable/ic_tab_coupons"
                app:tint="@color/text_secondary" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/main_LBL_tabCoupons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_coupons"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/main_LAY_tabProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/main_IMG_tabProfile"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/tab_profile"
                android:src="@drawable/ic_tab_profile"
                app:tint="@color/text_secondary" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/main_LBL_tabProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_profile"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/main_LBL_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_banner"
        android:elevation="8dp"
        android:gravity="center"
        android:padding="14dp"
        android:textColor="@color/banner_text"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
