<?xml version="1.0" encoding="utf-8"?>
<!--
  DEV-ONLY cleartext exception for local Wi-Fi testing.
  Android blocks plain HTTP by default (API 28+); the IntelliShop backend runs the
  Django dev server over HTTP on the Mac's LAN IP during the testing phase.

  ▶ Replace 192.168.1.100 below with the Mac's actual LAN IP (`ipconfig getifaddr en0`),
    and update it whenever DHCP reassigns the address. Keep Constants.Api.BASE_URL in sync.
  10.0.2.2 is the Android emulator's alias for the host loopback.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.68.109</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
